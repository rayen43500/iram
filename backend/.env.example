PORT=4000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=credit_app
MYSQL_USER=root
MYSQL_PASSWORD=
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=*
SCORING_MAX_DEBT_RATIO=0.35
AUTO_SEED_ON_START=true

# OTP email (si non configure, le code est logge en console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bank.local
OTP_EXPIRES_MINUTES=10

# Notifications push Expo (set true si vous voulez envoyer des push)
EXPO_PUSH_ENABLED=false

# true une fois après ajout de colonnes (ALTER), puis repasser à false en production stable
SEQUELIZE_ALTER=false
